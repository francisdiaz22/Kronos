# Kronos Web UI Environment Variables
# Copy this file to .env and fill in your values

# SECURITY: Set a secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Optional: Comet ML API Key for experiment tracking
# Leave empty if not using Comet ML
COMET_API_KEY=

# Optional: HuggingFace Token for model downloads
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Optional: Enable authentication (set to 'true' to require login)
# When enabled, you should implement authentication mechanism
AUTH_ENABLED=false

# Optional: Rate limiting (requests per hour per IP)
RATE_LIMIT=100

# Optional: Data directory for predictions (default: ./prediction_results)
PREDICTION_RESULTS_DIR=./prediction_results

# Optional: Enable HTTPS (set to 'true' for production with SSL)
# Requires configuring Flask with SSL context
USE_HTTPS=false
